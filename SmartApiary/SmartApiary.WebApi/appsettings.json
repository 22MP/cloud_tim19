{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureTableOptions": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "UsersTable": "Users"
  },
  "AzureQueueOptions": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "AzureBlobOptions": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "JwtOptions": {
    "Secret": "CHANGE_ME_WHEN_DEPLOYING_USE_LONG_SECRET",
    "Issuer": "SmartApiary",
    "Audience": "SmartApiary",
    "ExpirationMinutes": 60
  },
  "EmailOptions": {
    "ApiKey": "CHANGE_ME_WHEN_DEPLOYING",
    "SenderEmail": "CHANGE_ME_WHEN_DEPLOYING",
    "SenderName": "Smart Apiary"
  },
  "FrontendOptions": {
    "BaseUrl": "http://localhost:5173"
  },
  "WebApi": {
    "CorsPolicyName": "_reactAppPolicy",
    "ReactOrigin": "http://localhost:5173",
    "NotificationHubRoute": "/notification-hub"
  }
}